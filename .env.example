# ── Database ──────────────────────────────────────────────────────────────────
DB_BACKEND=postgres                      # postgres | duckdb

# Postgres (required when DB_BACKEND=postgres)
PGHOST=localhost
PGPORT=5432
PGDATABASE=questlab
PGUSER=questlab
PGPASSWORD=changeme
PGSSLMODE=require

# DuckDB (used for local dev / tests when DB_BACKEND=duckdb)
DUCKDB_PATH=./data/app.duckdb

# ── Auth ──────────────────────────────────────────────────────────────────────
# Header injected by Azure Front Door + Entra ID (prod only)
AUTH_EMAIL_HEADER=X-MS-CLIENT-PRINCIPAL-NAME

# Local dev fallback — NEVER set in prod
CURRENT_USER_EMAIL=dev@local.test

# Seeded into admins table on first run when table is empty
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# ── Uploads ───────────────────────────────────────────────────────────────────
# Vercel Blob — stores uploaded portraits, battle maps and .glb figures durably (Render's
# filesystem is ephemeral). Create a store in Vercel dashboard → Storage →
# Blob → copy the read-write token. Blank in local dev: uploads go to uploads/.
BLOB_READ_WRITE_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=development                          # development | production

# ── CORS (production deployments) ─────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API in
# production. Localhost dev origins are always allowed by default.
# Example for Vercel + Render split deploy:
#   CORS_ORIGINS=https://questlab.vercel.app
CORS_ORIGINS=

# ── Frontend (Vite) — set in Vercel, NOT in this file ─────────────────────────
# When the frontend is hosted separately from the API (Vercel + Render),
# set VITE_API_BASE_URL in Vercel's project env vars to the absolute backend
# URL including the /api prefix. Frontend reads it via import.meta.env.
# Empty / unset keeps the local Vite dev proxy ("/api" → localhost:8000).
# Example:
#   VITE_API_BASE_URL=https://questlab-api.onrender.com/api
# Optional: pre-fill the DM identity input on first load:
#   VITE_DM_EMAIL=you@example.com

# ── Plan 54: product/demo controls ─────────────────────────────────────────
# Demo deployments only: pins EVERY visitor to one shared demo identity and
# ignores the identity header entirely. Never set on prod.
DEMO_MODE=false
DEMO_DM_EMAIL=demo@questlab.app
# Frontend (Vercel env): marks the deployment as the public demo — shows the
# demo banner, routes /welcome to /try, enables the "Enter the demo" button.
#   VITE_DEMO_MODE=true

# ── Plan 57: the Session Notebook ──────────────────────────────────────────
# On by default (owner lit it 2026-07-30). Set false to go dark — every
# /notebook* route 403s. Always dark on DEMO_MODE deployments regardless.
NOTEBOOK_ENABLED=true

# ── Plan 73: public mode (see docs/LAUNCH.md). All optional; defaults = personal mode.
AUTH_MODE=header                 # header | oauth (oauth ignores the client email header) — production MUST be oauth (Plan 120)
APP_SECRET=                      # required for oauth mode — long random string
ACCOUNT_CLAIM_CODE=              # Plan 120: one-time code an existing DM enters to claim their email's campaigns; remove after
OAUTH_REDIRECT_BASE=             # e.g. https://api.example.com/api
FRONTEND_ORIGIN=                 # e.g. https://app.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_URL=
RATE_LIMIT=on                    # on | off — per-IP throttle on sign-in/sign-up/join and all writes
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_WRITES_PER_MIN=120

PUBLIC_WEB_URL=https://quest-lab-tau.vercel.app
# Plan 125 — the friends beta. `required` (default): a NEW DM account needs an
# invite code made in Admin → Beta; existing accounts, admins and players never
# do. `off`: open sign-up.
BETA_INVITES=required
# Optional: a Discord channel webhook that receives each feedback note.
FEEDBACK_WEBHOOK_URL=
# Plan 130 — pricing. `off` (default, the beta): nothing is capped. `on`: a Free DM
# gets 2 campaigns and 250 MB of uploads; Patrons ($4/month or $40/year on Patreon)
# get unlimited campaigns and 5 GB; admins have no caps. Players never pay.
PRICING=off
# QuestLab's Patreon campaign id: an active membership of it makes a DM a Patron.
# (PATREON_URL above is the public page for "Support QuestLab" / "Become a Patron".)
PATREON_CAMPAIGN_ID=
ARENA_SECRET=                    # optional; seals arena fights across deploys (falls back to APP_SECRET, then DB creds)
